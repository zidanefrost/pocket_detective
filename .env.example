# Required by the Node server. Never expose this value through a VITE_* variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional ElevenLabs narration. Without a key, the client uses the device's
# built-in speech engine.
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"
ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# Optional server overrides.
GEMINI_MODEL="gemini-3.6-flash"
PORT="3000"
