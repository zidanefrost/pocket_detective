# GEMINI_API_KEY: Required for Gemini AI API calls (room scanning + quest generation).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ELEVENLABS_API_KEY: Required for voice narration ("The Story Unfolds" & "The Clue").
# Get one at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# ELEVENLABS_VOICE_ID: Voice used for narration. Defaults to a deep British narrator
# ("George" = JBFqnCBsd6RMkjVDRZzb) if left unset.
ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
